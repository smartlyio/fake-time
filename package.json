{
  "name": "@smartlyio/fake-time",
  "license": "MIT",
  "version": "1.0.3",
  "description": "fake time and timers",
  "packageManager": "pnpm@11.22.0",
  "private": false,
  "engines": {
    "node": ">=22.13",
    "pnpm": "^11.22.0"
  },
  "author": "Smartly.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "pnpm exec jest",
    "render": "pnpm exec ts-node render.ts",
    "build": "rm -rf ./dist/* && pnpm run lint && pnpm run test && pnpm run render && pnpm exec tsc",
    "lint": "tslint -c tslint.json --project tsconfig.json",
    "lint:fix": "tslint --fix -c tslint.json --project tsconfig.json",
    "prepublish": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smartlyio/fake-time.git"
  },
  "peerDependencies": {
    "jest": "^29.0.0"
  },
  "keywords": [
    "jest",
    "timer",
    "timer",
    "mock time",
    "fake"
  ],
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "jest": "29.7.0",
    "jsverify": "0.8.4",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tslint": "6.1.3",
    "tslint-config-prettier": "1.18.0",
    "tslint-plugin-prettier": "2.3.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "examples/.*\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "jsx",
      "ts",
      "tsx"
    ],
    "preset": "ts-jest",
    "testMatch": null
  }
}
